<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="전체 경기 기록" Width="1450" Height="900" MinWidth="620" MinHeight="600" WindowState="Maximized" WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Malgun Gothic" FontSize="13" Foreground="#17253B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="5,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E5EBF3"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="RowHeight" Value="34"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E8EEF6"/><Setter Property="Padding" Value="10,9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="25,11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="ResultColor" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="승"><Setter Property="Foreground" Value="#087E6A"/></DataTrigger><DataTrigger Binding="{Binding Result}" Value="패"><Setter Property="Foreground" Value="#CC4B59"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="CompactCell" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="4,7"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="CompactResult" TargetType="TextBlock" BasedOn="{StaticResource ResultColor}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="3,7"/><Setter Property="TextAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="87"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="30"/></Grid.RowDefinitions>
  <Border Background="#12243D" Padding="22,15"><DockPanel LastChildFill="True"><Button x:Name="CloseOverview" DockPanel.Dock="Right" Content="입력 화면으로" VerticalAlignment="Center"/><StackPanel><TextBlock Text="전체 경기 기록" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="표 너비를 줄이면 더 많은 날짜를 나란히 볼 수 있습니다." Foreground="#B4C7DE" Margin="0,5,10,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
  <StackPanel Grid.Row="1" Margin="20,12">
   <TextBlock x:Name="OverviewStats" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="OverviewRange" Foreground="#64748B" Margin="0,5,0,0"/>
   <WrapPanel Margin="0,10,0,0">
    <StackPanel Orientation="Horizontal" Margin="0,0,12,4"><TextBox x:Name="OverviewSearch" Width="180" Padding="8,6" VerticalContentAlignment="Center" ToolTip="상대 또는 메모 검색"/><Button x:Name="ClearSearch" Content="검색 해제" Padding="10,6"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="표 너비" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="CardWidthSlider" Minimum="200" Maximum="520" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="40" Width="120" VerticalAlignment="Center" Value="{Binding CardWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="왼쪽으로 움직이면 날짜별 표가 좁아집니다. 200~520px"/><TextBlock x:Name="CardWidthLabel" Text="{Binding CardWidth, StringFormat={}{0:0}px}" Width="48" TextAlignment="Center" VerticalAlignment="Center"/><Button x:Name="DefaultWidthBtn" Content="기본" Padding="9,6" ToolTip="표 너비를 280px로 되돌립니다."/></StackPanel>
   </WrapPanel>
  </StackPanel>
  <TabControl Grid.Row="2" BorderThickness="0" Background="#F4F6FA" Margin="17,0,17,8">
   <TabItem Header="날짜별 모아보기">
    <Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="DayCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border x:Name="DayCardBorder" Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Background="White" BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="9" Margin="5,7" VerticalAlignment="Top">
      <StackPanel><Border Background="#E7F3EF" Padding="10,10" CornerRadius="9,9,0,0"><StackPanel><TextBlock Text="{Binding Date}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Label}" Foreground="#426957" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Total}" Foreground="#426957" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
       <Grid Background="#E8EEF6"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="#" Style="{StaticResource CompactCell}"/><TextBlock Grid.Column="1" Text="상대" Style="{StaticResource CompactCell}"/><TextBlock Grid.Column="2" Text="시간" Style="{StaticResource CompactCell}"/><TextBlock Grid.Column="3" Text="승패" Style="{StaticResource CompactCell}" TextAlignment="Center"/></Grid>
       <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E5EBF3" BorderThickness="0,0,0,1" ToolTip="{Binding Memo}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Round}" Style="{StaticResource CompactCell}" ToolTip="{Binding Round}"/><TextBlock Grid.Column="1" Text="{Binding Opponent}" Style="{StaticResource CompactCell}" ToolTip="{Binding Opponent}"/><TextBlock x:Name="DurationCell" Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource CompactCell}" FontFamily="Consolas" ToolTip="{Binding Duration}"/><TextBlock Grid.Column="3" Text="{Binding Result}" Style="{StaticResource CompactResult}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="OverviewEmpty" Text="표시할 기록이 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7B8BA1" FontSize="16" IsHitTestVisible="False"/></Grid>
   </TabItem>
   <TabItem Header="전체 목록"><DataGrid x:Name="AllGrid" MinColumnWidth="36" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="108"/><DataGridTextColumn Header="회차" Binding="{Binding Round}" Width="48"/><DataGridTextColumn Header="대전 상대" Binding="{Binding Opponent}" Width="150"/><DataGridTextColumn Header="시간" Binding="{Binding Duration}" Width="95"/><DataGridTextColumn Header="승패" Binding="{Binding Result}" Width="70" ElementStyle="{StaticResource ResultColor}"/><DataGridTextColumn Header="메모" Binding="{Binding Memo}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" x:Name="OverviewFooter" Text="최신 날짜부터 표시 · 표 너비는 200~520px로 조절됩니다. 긴 상대 이름은 마우스를 올려 확인하세요." Foreground="#64748B" Margin="20,5,20,7" FontSize="11" TextWrapping="Wrap"/>
 </Grid>
</Window>
