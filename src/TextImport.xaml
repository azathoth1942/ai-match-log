<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="메모장 기록 가져오기" Width="1280" Height="860" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterOwner" FontFamily="Malgun Gothic" FontSize="13" Background="#F4F6FA" Foreground="#17253B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="17,9"/><Setter Property="Margin" Value="5,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E8EEF6"/><Setter Property="Padding" Value="9,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="7,5"/></Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="45"/><RowDefinition Height="140"/><RowDefinition Height="51"/><RowDefinition Height="*"/><RowDefinition Height="45"/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="메모장 기록 가져오기" FontWeight="Bold" FontSize="23"/><TextBlock Text="내용을 붙여넣거나 TXT 파일을 연 뒤, 해석된 기록을 확인하고 저장하세요." Foreground="#64748B" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="날짜가 없는 줄의 기본 날짜" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker x:Name="DefaultDate" Width="145" Height="33"/><Button x:Name="OpenFile" Content="TXT 파일 열기"/></StackPanel><TextBlock Text="예: 2026-10-24 플루토 8:35 승" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#52647A"/></Grid>
  <TextBox Grid.Row="2" x:Name="RawText" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" FontFamily="Consolas, Malgun Gothic" FontSize="14" BorderBrush="#CBD5E1"/>
  <Grid Grid.Row="3"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ParseBtn" Content="아래 표로 변환" Background="#087E6A" Foreground="White"/><TextBlock x:Name="ParseStatus" Text="한 줄에 한 경기씩 입력하세요. 날짜만 있는 줄은 아래 경기들의 날짜가 됩니다." Foreground="#52647A" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Grid>
  <DataGrid Grid.Row="4" x:Name="PreviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" Background="White" AlternatingRowBackground="#F8FAFD" BorderBrush="#DAE2EE" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridCheckBoxColumn Header="추가" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
    <DataGridTextColumn Header="날짜" Binding="{Binding Date, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
    <DataGridTextColumn Header="상대" Binding="{Binding Opponent, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
    <DataGridTextColumn Header="시간 (분:초)" Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
    <DataGridComboBoxColumn Header="승패" x:Name="ImportResultColumn" SelectedItemBinding="{Binding Result, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
    <DataGridTextColumn Header="메모" Binding="{Binding Memo, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
    <DataGridTextColumn Header="확인 사항" Binding="{Binding Issue}" IsReadOnly="True" Width="170"/>
    <DataGridTextColumn Header="원문" Binding="{Binding Source}" IsReadOnly="True" Width="*" MinWidth="180"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="5" Text="날짜·상대·시간·승패는 표에서 직접 고칠 수 있습니다. '추가'가 체크된 줄만 저장됩니다.&#10;기존 기록과 내용이 같은 줄은 기본 해제됩니다. 실제로 다른 경기라면 직접 체크하세요." Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
  <Grid Grid.Row="6"><TextBlock x:Name="ImportHint" Text="원본 메모장 파일은 변경하지 않습니다." VerticalAlignment="Center" Foreground="#52647A"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelBtn" Content="취소"/><Button x:Name="ImportBtn" Content="선택 기록 저장" Background="#087E6A" Foreground="White" FontWeight="Bold"/></StackPanel></Grid>
 </Grid>
</Window>
