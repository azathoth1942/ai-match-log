<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AI 대전 기록" Width="1220" Height="840" MinWidth="1020" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Malgun Gothic" FontSize="13" Foreground="#17253B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DDE8"/><Setter Property="Foreground" Value="#24354C"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CED7E4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,7"/><Setter Property="BorderBrush" Value="#CED7E4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DatePicker"><Setter Property="Padding" Value="4,4"/><Setter Property="BorderBrush" Value="#CED7E4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EAF0F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="39"/><Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF2F8"/><Setter Property="Foreground" Value="#52647A"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="13,6"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="13,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="20,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#52647A"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20,15"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="BorderBrush" Value="#E4EAF2"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="33"/></Grid.RowDefinitions>
  <Border Background="#12243D" Padding="25,0">
   <Grid>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="AI 대전 기록" FontSize="25" FontWeight="Bold" Foreground="White"/><TextBlock Text="한 경기씩 기록하고, 쌓인 결과를 확인하세요." Foreground="#A9BDD5" FontSize="12" Margin="1,5,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="OverviewBtn" Content="전체 기록 보기" Background="#087E6A" Foreground="White" FontWeight="Bold"/><Button x:Name="TextImportBtn" Content="메모장 가져오기"/><Button x:Name="BackupBtn" Content="백업 저장"/><Button x:Name="RestoreBtn" Content="백업 불러오기"/><Button x:Name="HelpBtn" Content="사용 안내"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="24,18,24,14">
   <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="100"/><RowDefinition Height="199"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
     <TextBlock Text="조회" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,13,0"/>
     <ComboBox x:Name="FilterMode" Width="105" Margin="0,0,8,0"><ComboBoxItem Content="전체 기록"/><ComboBoxItem Content="월별"/><ComboBoxItem Content="날짜별"/></ComboBox>
     <DatePicker x:Name="FilterDate" Width="145" SelectedDateFormat="Short" Margin="0,0,8,0"/>
     <Button x:Name="TodayBtn" Content="오늘" Padding="12,5" MinHeight="33"/>
     <TextBlock x:Name="FilterLabel" Foreground="#52647A" VerticalAlignment="Center" Margin="13,0,0,0"/>
    </StackPanel>
    <TextBox x:Name="SearchBox" Width="220" Height="33" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="상대 이름 또는 메모 검색"/>
    <TextBlock x:Name="SearchHint" Text="상대 이름 · 메모 검색" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#7B8BA1" Width="200" Margin="0,9,8,0"/>
   </Grid>
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,4,-12,12">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="총 경기" Foreground="#66788F"/><TextBlock x:Name="CountText" Text="0판" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="승 · 패 · 무승부" Foreground="#66788F"/><TextBlock x:Name="ResultsText" Text="0승  0패  0무" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="승률  (무승부 제외)" Foreground="#66788F"/><TextBlock x:Name="RateText" Text="—" Foreground="#087E6A" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="누적 경기 시간" Foreground="#66788F"/><TextBlock x:Name="TimeText" Text="0시간 0분 0초" FontSize="21" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
   </UniformGrid>
   <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E7F0" BorderThickness="1" Padding="18,14" Margin="0,0,0,14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="71"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><TextBlock x:Name="EditorTitle" Text="새 경기 기록" FontSize="15" FontWeight="Bold"/><TextBlock Text="  시간은 직접 입력하거나 타이머로 측정하세요." Foreground="#718198" FontSize="12" VerticalAlignment="Center"/></StackPanel>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0"><TextBlock Text="경기 날짜" Style="{StaticResource Label}"/><DatePicker x:Name="MatchDate" Height="36" SelectedDateFormat="Short"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="대전 상대" Style="{StaticResource Label}"/><ComboBox x:Name="OpponentBox" IsEditable="True" IsTextSearchEnabled="False" Height="36"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="경기 시간  (분:초)" Style="{StaticResource Label}"/><TextBox x:Name="DurationBox" Text="00:00" Height="36" FontFamily="Consolas" FontSize="17" ToolTip="예: 8:35 = 8분 35초 / 1:02:30 = 1시간 2분 30초"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="승패  (내 기준)" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="36"><RadioButton x:Name="WinRadio" Content="승리" GroupName="Result" Foreground="#087E6A" FontWeight="Bold" Margin="0,9,19,0"/><RadioButton x:Name="LossRadio" Content="패배" GroupName="Result" Foreground="#CC4B59" FontWeight="Bold" Margin="0,9,19,0"/><RadioButton x:Name="DrawRadio" Content="무승부" GroupName="Result" Margin="0,9,0,0"/></StackPanel></StackPanel>
     </Grid>
     <Grid Grid.Row="2" Margin="0,5,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0" Height="35" VerticalAlignment="Top"><TextBox x:Name="MemoBox" ToolTip="메모 (선택): 맵, 종족, 특이사항 등"/><TextBlock x:Name="MemoHint" Text="메모 (선택) · 맵, 종족, 특이사항 등" Foreground="#7B8BA1" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="TimerBtn" Content="▶ 타이머 시작" Padding="10,7"/><Button x:Name="ResetTimerBtn" Content="초기화" Padding="10,7"/><Button x:Name="CancelEditBtn" Content="수정 취소" Visibility="Collapsed" Padding="10,7"/><Button x:Name="SaveBtn" Content="＋ 기록 추가" Background="#087E6A" Foreground="White" BorderBrush="#087E6A" FontWeight="Bold" Padding="19,7"/></StackPanel>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Row="3" Background="White" CornerRadius="10" BorderBrush="#E0E7F0" BorderThickness="1" Padding="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Button x:Name="TextExportBtn" Content="메모장 내보내기 ▾" HorizontalAlignment="Left" Margin="12,5,0,5" Padding="12,5" MinHeight="31" ToolTip="전체 기록 또는 현재 조회·검색 결과를 TXT 파일로 저장합니다."><Button.ContextMenu><ContextMenu><MenuItem Header="전체 기록 내보내기"/><MenuItem Header="현재 조회·검색 결과 내보내기"/></ContextMenu></Button.ContextMenu></Button>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,9,5"><Button x:Name="EditBtn" Content="선택 기록 수정" Padding="12,5" MinHeight="31"/><Button x:Name="DeleteBtn" Content="선택 기록 삭제" Padding="12,5" MinHeight="31" Foreground="#BA4350"/></StackPanel>
     <TabControl Grid.Row="1" x:Name="Tabs" BorderThickness="0" Background="White" Margin="6,0,6,6">
      <TabItem Header="경기 기록">
       <Grid><DataGrid x:Name="MatchesGrid"><DataGrid.Columns>
        <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="115"/>
        <DataGridTextColumn Header="회차" Binding="{Binding Round}" Width="65"/>
        <DataGridTextColumn Header="대전 상대" Binding="{Binding Opponent}" Width="180"/>
        <DataGridTextColumn Header="경기 시간" Binding="{Binding Duration}" Width="115"/>
        <DataGridTextColumn Header="승패" Binding="{Binding Result}" Width="85"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="승"><Setter Property="Foreground" Value="#087E6A"/></DataTrigger><DataTrigger Binding="{Binding Result}" Value="패"><Setter Property="Foreground" Value="#CC4B59"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        <DataGridTextColumn Header="메모" Binding="{Binding Memo}" Width="*"/>
       </DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" Text="아직 기록이 없습니다. 위에서 첫 경기를 입력해보세요." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7B8BA1" IsHitTestVisible="False"/></Grid>
      </TabItem>
      <TabItem Header="날짜별 합계"><DataGrid x:Name="DaysGrid"><DataGrid.Columns>
       <DataGridTextColumn Header="날짜" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="경기 수" Binding="{Binding Count}" Width="100"/><DataGridTextColumn Header="승 / 패 / 무" Binding="{Binding Results}" Width="150"/><DataGridTextColumn Header="승률" Binding="{Binding Rate}" Width="100"/><DataGridTextColumn Header="누적 시간" Binding="{Binding Total}" Width="190"/><DataGridTextColumn Header="평균 시간" Binding="{Binding Average}" Width="*"/>
      </DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="상대별 통계"><DataGrid x:Name="OpponentsGrid"><DataGrid.Columns>
       <DataGridTextColumn Header="대전 상대" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="경기 수" Binding="{Binding Count}" Width="100"/><DataGridTextColumn Header="승 / 패 / 무" Binding="{Binding Results}" Width="150"/><DataGridTextColumn Header="승률" Binding="{Binding Rate}" Width="100"/><DataGridTextColumn Header="누적 시간" Binding="{Binding Total}" Width="190"/><DataGridTextColumn Header="평균 시간" Binding="{Binding Average}" Width="130"/>
      </DataGrid.Columns></DataGrid></TabItem>
     </TabControl>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#E9EEF5" Padding="25,7"><Grid><TextBlock x:Name="StatusText" Text="준비됨 · 기록은 변경할 때마다 자동 저장됩니다." FontSize="11" Foreground="#52647A"/><TextBlock Text="AI 대전 기록 1.2" FontSize="11" Foreground="#718198" HorizontalAlignment="Right"/></Grid></Border>
 </Grid>
</Window>
